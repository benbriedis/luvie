/* Windows resource script — generated into the build tree from luvie.rc.in.
 *
 * This is where a Windows executable gets the two things Linux reads out of
 * luvie.desktop and the hicolor icon theme: the icon Explorer and the taskbar show,
 * and the version/publisher metadata the file properties dialog displays.
 *
 * The lowest-numbered ICON resource is the one the shell uses for the .exe, hence the
 * literal id 1 rather than a named identifier.
 */

#include <windows.h>

1 ICON "@LUVIE_ICO@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @LUVIE_VERSION_COMMAS@
    PRODUCTVERSION @LUVIE_VERSION_COMMAS@
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0409 = US English, 04b0 = Unicode. */
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Ben Briedis"
            VALUE "FileDescription",  "Luvie - pattern-based MIDI sequencer"
            /* The full `git describe` string, so a bug report can name the exact build. */
            VALUE "FileVersion",      "@LUVIE_VERSION@"
            VALUE "InternalName",     "luvie"
            VALUE "LegalCopyright",   "Copyright 2025-2026 Ben Briedis. Apache-2.0."
            VALUE "OriginalFilename", "luvie.exe"
            VALUE "ProductName",      "Luvie"
            VALUE "ProductVersion",   "@LUVIE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
