@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .

<https://github.com/benbriedis/luvie/luvie_dsp>
    a lv2:Plugin , lv2:MIDIPlugin ;
    doap:name "Luvie" ;
    doap:maintainer [
        foaf:name "Ben Briedis"
    ] ;
    doap:license <http://spdx.org/licenses/Apache-2.0> ;

    lv2:requiredFeature urid:map , work:schedule ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:extensionData state:interface , work:interface ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports time:Position ;
        lv2:designation lv2:control ;
        lv2:index 0 ;
        lv2:symbol "control_in" ;
        lv2:name "Control In" ;
        # The UI sends the whole project as one JSON-blob atom on this port, so the
        # host must size the buffer big enough to hold an entire session per event.
        rsz:minimumSize 524288
    ] , [
        # Output 1 is the original single output and keeps its symbol, so sessions
        # saved before the extra ports existed still connect. It alone carries the
        # time:Position (UI playhead) and state:StateChanged (host dirty flag);
        # outputs 2..8 are plain MIDI. Nothing may be inserted BEFORE this port —
        # an atom output ahead of it breaks Ardour's MIDI routing.
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        atom:supports time:Position ;
        atom:supports state:StateChanged ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out 1"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 2 ;
        lv2:symbol "midi_out_2" ;
        lv2:name "MIDI Out 2"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 3 ;
        lv2:symbol "midi_out_3" ;
        lv2:name "MIDI Out 3"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 4 ;
        lv2:symbol "midi_out_4" ;
        lv2:name "MIDI Out 4"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 5 ;
        lv2:symbol "midi_out_5" ;
        lv2:name "MIDI Out 5"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 6 ;
        lv2:symbol "midi_out_6" ;
        lv2:name "MIDI Out 6"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 7 ;
        lv2:symbol "midi_out_7" ;
        lv2:name "MIDI Out 7"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 8 ;
        lv2:symbol "midi_out_8" ;
        lv2:name "MIDI Out 8"
    ] ;

    ui:ui <https://github.com/benbriedis/luvie/luvie_ui> .
